          "scale": 172800
        }
      ],
      "output_csv": false
    },
    {
      "name": "lead_time",
      "type": "integer",
      "time_unit": "s",
      "expression": "lt_prebooked if is_prebooked >= 0.5 else lt_dynamic"
    },
    {
      "name": "earliest_departure",
      "type": "integer",
      "time_unit": "s",
      "pdf": [
        {
          "type": "normal",
          "loc": 51805,
          "scale": 11568
        }
      ],
      "constraints": [
        "earliest_departure >= min_early_departure",
        "earliest_departure <= max_early_departure"
      ]
    },
    {
      "name": "time_stamp",
      "type": "integer",
      "time_unit": "s",
      "expression": "earliest_departure - lead_time"
    },
    {
      "name": "origin",
      "type": "location",
      "subset_locations": "all_stops"
    },
    {
      "name": "destination",
      "type": "location",
      "subset_locations": "all_stops"
    },
    {
      "name": "direct_distance",
      "type": "integer",
      "length_unit": "m",
      "expression": "dist_drive(origin,destination)",
      "constraints": [
        "direct_distance >= min_distance"
      ],
      "output_csv": true
    },
    {
      "name": "direct_travel_time",
      "type": "integer",
      "time_unit": "s",
      "expression": "dtt(origin,destination)",
      "constraints": [
        "direct_travel_time > 0"
      ]
    },
    {
      "name": "latest_arrival",
      "type": "integer",
      "time_unit": "s",
      "expression": "earliest_departure + direct_travel_time + 600"
    }
  ]
